    {
        "id": "f7f1552bb256958f",
        "type": "function",
        "z": "29a480ac2e0d4dd9",
        "name": "function 1",
        "func": "// Get the current number from node context (default to 2)\nlet count = context.get('count') || 2;\n\n// Set the payload to the current number\nmsg.payload = count;\n\n// Increment the counter, and reset back to 2 if it passes 5\ncount++;\nif (count > 5) {\n    count = 2;\n}\n\n// Save the updated number for the next run\ncontext.set('count', count);\n\nreturn msg;",
