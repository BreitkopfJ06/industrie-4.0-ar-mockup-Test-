    {
        "id": "d631fcd53662df9a",
        "type": "function",
        "z": "29a480ac2e0d4dd9",
        "name": "Alarm mit Recovery Threshold",
        "func": "const ALARM_THRESHOLD    = 4.0; // Adjust to your machine's mm/s\nconst RECOVERY_THRESHOLD = 3; // Must be lower than ALARM_THRESHOLD\n\n// Works whether msg.payload is a plain number or { value: ... }\nconst value = typeof msg.payload === \"object\" ? parseFloat(msg.payload.value) : parseFloat(msg.payload);\nif (isNaN(value)) return null;\n\nlet active = context.get(\"active\") || false;\n\n// Trigger Alarm (once)\nif (!active && value > ALARM_THRESHOLD) {\n    active = true;\n    context.set(\"active\", active);\n    msg.payload = { state: \"alarm\", value: value, ts: Date.now() };\n    return msg;\n}\n\n// Trigger Recovery / Entwarnung (once)\nif (active && value < RECOVERY_THRESHOLD) {\n    active = false;\n    context.set(\"active\", active);\n    msg.payload = { state: \"ok\", value: value, ts: Date.now() };\n    return msg;\n}\n\nreturn null; // Do not send anything in between",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1110,
        "y": 600,
        "wires": [
